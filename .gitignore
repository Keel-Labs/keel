node_modules/
dist/
dist-packages/
.DS_Store
*.env
brain/
.config/
build/icon.iconset/
build/icon.png
archive/

# Maintainer-only specs and design docs — internal product thinking that
# shouldn't live in the public repo. Keep them locally; just don't track.
specs/

# Personal workspace data — when Keel runs from this checkout, the user's
# brain folder lives here as untracked files. These must NEVER be committed.
# (This is what ~/Keel becomes when the maintainer runs the dev build from
# this directory.) If you add new workspace folder names in fileManager.ts,
# add them here too.
daily-log/
meetings/
inbox/
knowledge-bases/
projects/
pulse.md
tasks.md
keel.md

# Local agent worktrees — created by Claude Code / similar tools. Never source.
.claude/worktrees/
.claude/scheduled_tasks.lock

# iOS / Xcode asset scratch — the mobile companion's app icon source files,
# Capacitor working directory, and downloaded icon-generator bundles. These
# belong in the Keel-Labs/keel-ios repo, not this one. Asset PNGs that
# eventually go to App Store / Play Store listings (Keel.png, appstore.png,
# playstore.png) are deliberately NOT ignored so they can be committed when
# the user is ready.
AppIcon.iconset/
AppIcons*.zip
Assets.xcassets/
ios/
build/icon_1024.png
build/icon_master.png
build/k-crop.png
.env.local
